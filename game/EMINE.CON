// Shift Happens: the game script.
//
// Written for this game, in place of the original game's GAME.CON, DEFS.CON and USER.CON. Most of the game lives in
// C++ (the block world, mobs, food, ore drops, voice: engine/source/duke3d/src/emine*.cpp); this script covers what
// the engine still hands to a script:
//   - start-up settings (health, ammo limits, blast radii) and the one world;
//   - the messages the engine shows;
//   - how much damage each weapon's hit does;
//   - the ammo pickups that ores drop;
//   - explosions, smoke, bullet sparks, flames and blood;
//   - the mobs (their behaviour is C++; here they're declared, with the named animations the C++ looks up);
//   - the player: taking hits, dying and starting again.
// Sounds aren't defined here: the slots get their files at start-up from sounds/sfx/sfx.txt (tools/mksfx.py) and
// the voice sheet (tools/mkvoice.py). Tile numbers are the engine's; the art in them is ours.


// ---- names for the engine's tile numbers ------------------------------------------------------------------------

define PLAYER_TILE       1405
define ZOMBIE_TILE       2000
define SKELETON_TILE     1680
define SPIDER_TILE       2120
define LURKER_TILE       1880    // drawn from its own range by the C++ (Emine_MobTile)

define KICK_HIT_TILE     2521    // the kick's hit
define BULLET_TILE       2595    // pistol bullet strike (spark)
define MINIGUN_HIT_TILE  2536
define SHOTGUN_HIT_TILE  2613
define PIPEBOMB_TILE     26      // a thrown pipe bomb
define ROCKET_TILE       2605    // rocket launcher and devastator missiles

define PISTOL_AMMO_TILE  40      // coal
define MINIGUN_AMMO_TILE 41      // gold
define DEVASTATOR_AMMO_TILE 42   // lapis
define ROCKET_AMMO_TILE  44      // diamond
define PIPEBOMB_AMMO_TILE 47     // redstone
define SHELLS_TILE       49      // iron
define HEART_TILE        51      // a heart: a little health

define EXPLOSION_TILE    1890
define SMOKE_TILE        2329
define FLAME_TILE        2270    // something burning (a mob in lava)
define BIG_FLAME_TILE    2310
define BLOOD_TILE        1620
define RADIUS_BLAST      1670    // what the engine says hit you when a blast's radius catches you

// player states, for "ifp" (the engine's bit values)
define P_ALIVE 16384

// how an actor's move is applied (actor ... move flags)
define MOVE_H 2     // horizontal speed
define MOVE_V 4     // vertical speed

// weapons, as the engine numbers them
define W_KICK        0
define W_PISTOL      1
define W_SHOTGUN     2
define W_MINIGUN     3
define W_ROCKETS     4
define W_PIPEBOMB    5
define W_DEVASTATOR  7

// sound slots (their files come from sounds/sfx/sfx.txt and the voice sheet)
define S_PICKUP      210
define S_HURT        38     // voice: a grunt
define S_DEATH1      37     // voice: dying lines
define S_DEATH2      203
define S_DEATH3      72
define S_DEATH4      271
define S_SQUISH      69


// ---- settings -----------------------------------------------------------------------------------------------------

define START_HEALTH      100
define MAX_HEALTH_PICKUP 200

gamestartup
    512     // default visibility
    10      // damage from hitting a wall or ceiling hard
    100     // player's full health
    0       // armour at the start
    768     // actor respawn time (unused: nothing respawns)
    768     // item respawn time (unused)
    53200   // running speed
    1780    // rocket blast radius
    2500    // pipe bomb blast radius
    650     // (shrinker: unused)
    3880    // (trip mine: unused)
    2500    // (mortar: unused)
    2500    // (bouncing mine: unused)
    2048    // (seenine: unused)
    200     // most pistol ammo you can carry
    50      // shotgun shells
    200     // minigun rounds
    50      // rockets
    50      // pipe bombs
    50      // (shrinker: unused)
    99      // devastator missiles
    10      // (trip mines: unused)
    99      // (freezer: unused)
    0       // cameras can't be broken (there are none)
    3       // (freezer bounces: unused)
    1       // (freezer hurts its owner: unused)


// ---- the one world ------------------------------------------------------------------------------------------------

definevolumename 0 The Mines
defineskillname 0 Gentle
defineskillname 1 Normal
defineskillname 2 Hard
defineskillname 3 Brutal
definelevelname 0 0 E1L1.map 00:00 00:00 The Mines


// ---- messages -----------------------------------------------------------------------------------------------------
// The engine shows these by number. 13 is the death message: the engine swaps "SPACE" for whatever key opens things.

definequote 0   AUTO AIM
definequote 1   MAP: OFF
definequote 2   ON
definequote 4   LOCKED
definequote 5   EVERYTHING!
definequote 7   DOWN!
definequote 8   UNLOCKED
definequote 10  SQUASHED!
definequote 13  PRESS SPACE TO TRY AGAIN
definequote 15  OFF
definequote 17  GOD MODE: ON
definequote 18  GOD MODE: OFF
definequote 20  CROSSHAIR: ON
definequote 21  CROSSHAIR: OFF
definequote 22  CHEATS ARE OFF
definequote 23  MESSAGES: ON
definequote 24  MESSAGES: OFF
definequote 25  CHEAT:
definequote 28  < EMPTY >
definequote 34  SOUND: ON
definequote 35  SOUND: OFF
definequote 36  SCREENSHOT SAVED
definequote 44  MOUSE AIM: OFF
definequote 45  MOUSE AIM: ON
definequote 46  UNKNOWN CHEAT
definequote 73  WEAPON DOWN
definequote 74  WEAPON UP
definequote 80  KICK
definequote 81  WEAPON MODE: ON
definequote 82  WEAPON MODE: OFF
definequote 83  MAP FOLLOW: OFF
definequote 84  MAP FOLLOW: ON
definequote 85  RUN: OFF
definequote 86  RUN: ON
definequote 92  MUSIC: ON
definequote 93  MUSIC: OFF
definequote 103 SCREENSHOT SAVED
definequote 109 VIEW: FIRST PERSON
definequote 110 VIEW: BEHIND
definequote 111 MAP: ON
definequote 112 NO-CLIP: OFF
definequote 113 NO-CLIP: ON
definequote 114 THAT SAVE IS FROM ANOTHER VERSION
definequote 115 <Please Leave Blank>
definequote 116 <Please Leave Blank>
definequote 117 <Please Leave Blank>
definequote 118 YOU CAN'T SAVE WHILE DEAD
definequote 119 ALL WEAPONS AND AMMO
definequote 120 ALL ITEMS
definequote 121 ALL KEYS
definequote 122 <Please Leave Blank>
definequote 124 THAT SAVE IS FOR A DIFFERENT NUMBER OF PLAYERS

// pickups
definequote 200 PISTOL AMMO
definequote 201 SHOTGUN SHELLS
definequote 202 MINIGUN ROUNDS
definequote 203 ROCKETS
definequote 204 PIPE BOMBS
definequote 205 DEVASTATOR MISSILES
definequote 206 HEALTH +10


// ---- weapon damage ------------------------------------------------------------------------------------------------
// A hit's damage is its strength (the pistol adds 0-5 at random; rockets and pipe bombs fall off with distance,
// a direct rocket hit counts double).

actor KICK_HIT_TILE    10 enda
actor MINIGUN_HIT_TILE  9 enda
actor SHOTGUN_HIT_TILE 10 enda
actor PIPEBOMB_TILE   140 enda
actor ROCKET_TILE     140 enda

// the pistol's strike also shows a spark where it lands
action SPARK_FRAMES 0 4 1 1 6
actor BULLET_TILE 6 SPARK_FRAMES
    ifdead killit
    ifactioncount 4 killit
enda


// ---- pickups ------------------------------------------------------------------------------------------------------
// Ores drop these (emine.cpp). Walk over one to take it: a chime and a flash.

define PICKUP_REACH 844

state taken
    globalsound S_PICKUP
    palfrom 16 0 32
    killit
ends

actor PISTOL_AMMO_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_PISTOL 12 quote 200 state taken }
enda

actor SHELLS_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_SHOTGUN 10 quote 201 state taken }
enda

actor MINIGUN_AMMO_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_MINIGUN 50 quote 202 state taken }
enda

actor ROCKET_AMMO_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_ROCKETS 5 quote 203 state taken }
enda

actor PIPEBOMB_AMMO_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_PIPEBOMB 5 quote 204 state taken }
enda

actor DEVASTATOR_AMMO_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifcanseetarget
        { addammo W_DEVASTATOR 15 quote 205 state taken }
enda

actor HEART_TILE
    fall
    ifp P_ALIVE ifcount 6 ifpdistl PICKUP_REACH ifphealthl START_HEALTH
        { addphealth 10 quote 206 state taken }
enda


// ---- effects ------------------------------------------------------------------------------------------------------

// an explosion plays its 20 frames once
action BLAST_FRAMES 0 20 1 1 4
actor EXPLOSION_TILE 1 BLAST_FRAMES
    ifactioncount 20 killit
enda

// a puff of smoke drifts up and goes
action PUFF_FRAMES 0 4 1 1 10
move PUFF_RISE 0 -24
actor SMOKE_TILE 0 PUFF_FRAMES PUFF_RISE MOVE_V
    ifactioncount 4 killit
enda

// a burning mob's flames: burn a few seconds, shrink and go; stand too close and they singe you
action FLAME_FRAMES 0 14 1 1 2
state burn
    ifp P_ALIVE ifpdistl 844 ifrnd 32 ifcansee { soundonce S_HURT addphealth -1 palfrom 24 16 }
    ifcount 90 { sizeto 8 8 ifcount 120 killit }
ends
actor FLAME_TILE 5 FLAME_FRAMES
    state burn
enda
actor BIG_FLAME_TILE 5 FLAME_FRAMES
    state burn
enda

// a spurt of blood where a mob is hit
action SPURT_FRAMES 0 4 1 1 8
actor BLOOD_TILE 0 SPURT_FRAMES
    sizeto 64 64
    ifactioncount 4 killit
enda


// ---- mobs ---------------------------------------------------------------------------------------------------------
// Their behaviour is C++ (emine_mobs.cpp, which runs before any script code for these). Declared here so the engine
// treats them as actors, with the named animations the C++ asks for: start frame, frames, views, step, delay.

action ZOMBIE_WALK    0  4 5 1 20
action ZOMBIE_STAND  30  1 5 1 1
action ZOMBIE_HIT    55  1 1 1 10
action ZOMBIE_DYING  55  5 1 1 15
action ZOMBIE_DEAD   60  1 1 1 1
actor ZOMBIE_TILE 40 ZOMBIE_STAND enda

action SKELETON_WALK    0 4 5 1 12
action SKELETON_STAND   0 1 5 1 1
action SKELETON_HIT    50 1 1 1 6
action SKELETON_SHOOT  35 1 5 1 30
action SKELETON_DYING  50 5 1 1 16
action SKELETON_DEAD   54
actor SKELETON_TILE 40 SKELETON_STAND enda

action SPIDER_WALK     0 4 5 1 15
action SPIDER_IDLE    20 2 5 1 40
action SPIDER_LUNGE   30 1 5 1 2
action SPIDER_DYING   60 6 1 1 15
action SPIDER_DEAD    65 1
actor SPIDER_TILE 32 SPIDER_IDLE enda

actor LURKER_TILE 40 SPIDER_IDLE enda


// ---- the player ---------------------------------------------------------------------------------------------------
// Movement, weapons and the view are the engine's. This takes hits (a grunt and a red flash), and on death says a
// last line, falls, and waits for the open key to start again. The player's own body is never seen.

action PL_STAND 0 1 5 1 1
action PL_DOWN  113 1 1

actor PLAYER_TILE 100 PL_STAND 0 0
    ifaction 0 action PL_STAND

    ifdead
    {
        fall    // every tic: the body (and the view) settles to the ground
        ifaction PL_DOWN
        {
            quote 13
            ifhitspace { action PL_STAND resetplayer }
            break
        }
        ifrnd 64 sound S_DEATH1
        else ifrnd 85 sound S_DEATH2
        else ifrnd 128 sound S_DEATH3
        else sound S_DEATH4
        action PL_DOWN
        break
    }

    ifsquished
    {
        strength -1
        sound S_SQUISH
        break
    }

    ifhitweapon
    {
        ifdead break
        sound S_HURT
        ifwasweapon ROCKET_TILE { palfrom 48 52 break }
        ifwasweapon RADIUS_BLAST { palfrom 48 52 break }
        ifwasweapon KICK_HIT_TILE { palfrom 16 32 break }
        palfrom 24 48
        break
    }
enda
